<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Core is the library both front-ends build on: document its public surface (CS1591 is an error in CI). -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <!-- Implementations are internal; the front-ends and tests reach them directly, and Moq proxies internal interfaces. -->
    <InternalsVisibleTo Include="Remote.Adb.Console" />
    <InternalsVisibleTo Include="Remote.Adb.Core.UnitTests" />
    <InternalsVisibleTo Include="Remote.Adb.Desktop" />
    <InternalsVisibleTo Include="Remote.Adb.Desktop.UnitTests" />
    <InternalsVisibleTo Include="Remote.Adb.Testing" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

</Project>
