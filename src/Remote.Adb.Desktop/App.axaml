<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Remote.Adb.Desktop.App"
             xmlns:local="using:Remote.Adb.Desktop"
             xmlns:theme="using:CCSWE.Avalonia.Material"
             RequestedThemeVariant="Dark">
             <!-- CCSWE design system ships dark by default. Use "Light" or "Default" (follow system) to switch. -->
             <!-- The ViewLocator is a DI-backed data template registered in code (App.OnFrameworkInitializationCompleted). -->

    <Application.Styles>
        <!-- Standalone Material 3 theme: supplies the whole control surface itself, no separate base theme required. -->
        <theme:MaterialTheme DensityStyle="Compact" />

        <!-- App card convention: the standard surface (emulator rows, detail sections, settings cards) is an
             elevated Card with a 1px OutlineVariant hairline. Defined once here so every Classes="Elevated"
             Card matches — don't repeat the BorderBrush/BorderThickness inline. -->
        <Style Selector="theme|Card.Elevated">
            <Setter Property="BorderBrush" Value="{DynamicResource OutlineVariant}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Form conventions, defined once so every form matches:
             a field is a label over its input (StackPanel.Field + TextBlock.FieldLabel), and a form's inline error
             line is a TextBlock.ErrorText bound to the message — it hides itself while the message is empty. -->
        <Style Selector="StackPanel.Field">
            <Setter Property="Spacing" Value="4"/>
        </Style>
        <Style Selector="TextBlock.FieldLabel">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeBodySmall}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariant}"/>
        </Style>
        <Style Selector="TextBlock.ErrorText">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeBodySmall}"/>
            <Setter Property="Foreground" Value="{DynamicResource Error}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="IsVisible" Value="{Binding $self.Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
        </Style>
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Remote.Adb.Desktop/Themes/Icons.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
