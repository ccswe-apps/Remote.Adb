<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wl="using:Remote.Adb.Desktop.Devices.Wireless"
        x:Class="Remote.Adb.Desktop.Devices.Wireless.AddWirelessDeviceWindow"
        x:DataType="wl:AddWirelessDeviceViewModel"
        Title="Add wireless device"
        Width="640" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="{DynamicResource BodyFontFamily}"
        Background="{DynamicResource Surface}">

    <!-- Pair first (Android 11+), or connect directly by address. Devices connect through the local adb server, so
         they're also visible on the remote host through the tunnel. -->
    <StackPanel Margin="24" Spacing="16">
        <TextBlock Classes="TitleMedium" Foreground="{DynamicResource OnSurfaceStrong}" Text="Add wireless device"/>

        <Border Classes="Card Filled" Padding="12,8" IsVisible="{Binding PairedNotice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Classes="BodySmall" Text="{Binding PairedNotice}" TextWrapping="Wrap" Foreground="{DynamicResource OnSurface}"/>
        </Border>

        <!-- Each tab pairs its form with the matching devices found on the network (one shared poller). -->
        <TabControl SelectedIndex="{Binding SelectedTab}">
            <TabItem Header="Pair">
                <StackPanel Spacing="20" Margin="0,16,0,0">
                    <!-- Scan the QR code, or type the pairing code — whichever the device shows. The code form is
                         disabled while a scanned code is pairing, so the two can't race. -->
                    <Grid ColumnDefinitions="Auto,24,*">
                        <wl:QrPairingView Grid.Column="0" DataContext="{Binding Qr}"/>
                        <Panel Grid.Column="2" IsEnabled="{Binding !Qr.IsBusy}">
                            <wl:PairingCodeView DataContext="{Binding Pair}"/>
                        </Panel>
                    </Grid>
                    <wl:DiscoveredServicesView Title="Waiting to pair on this network"
                                               Services="{Binding Discovery.PairingServices}"
                                               IsUnavailable="{Binding Discovery.IsUnavailable}"
                                               SelectCommand="{Binding SelectPairingServiceCommand}"
                                               EmptyText="None yet — devices appear here while their pairing-code dialog is open. Pick one to fill in its address."/>
                </StackPanel>
            </TabItem>
            <TabItem Header="Connect">
                <StackPanel Spacing="20" Margin="0,16,0,0">
                    <wl:ConnectAddressView DataContext="{Binding Connect}"/>
                    <wl:DiscoveredServicesView Title="Ready to connect on this network"
                                               Services="{Binding Discovery.ConnectServices}"
                                               IsUnavailable="{Binding Discovery.IsUnavailable}"
                                               SelectCommand="{Binding ConnectToServiceCommand}"
                                               EmptyText="None found — paired devices with Wireless debugging on appear here. Pick one to connect."/>
                </StackPanel>
            </TabItem>
        </TabControl>

        <Button Classes="Text" Content="Cancel" Command="{Binding CancelCommand}" HorizontalAlignment="Right" IsCancel="True"/>
    </StackPanel>

</Window>
