<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wl="using:Remote.Adb.Desktop.Devices.Wireless"
             x:Class="Remote.Adb.Desktop.Devices.Wireless.PairingCodeView"
             x:DataType="wl:PairingCodeViewModel">

    <StackPanel Spacing="16">
        <TextBlock Classes="BodyMedium" Foreground="{DynamicResource OnSurfaceVariant}" TextWrapping="Wrap"
                   Text="On the device, open Developer options › Wireless debugging › Pair device with pairing code, then enter what it shows."/>

        <StackPanel Classes="Field">
            <TextBlock Classes="FieldLabel" Text="IP address &amp; port"/>
            <TextBox Text="{Binding PairingAddress}" PlaceholderText="192.168.1.20:37123"
                     FontFamily="{DynamicResource CodeFontFamily}" AutomationProperties.Name="Pairing address"/>
        </StackPanel>

        <StackPanel Classes="Field">
            <TextBlock Classes="FieldLabel" Text="Wi-Fi pairing code"/>
            <TextBox Text="{Binding Code}" PlaceholderText="123456" MaxLength="10"
                     FontFamily="{DynamicResource CodeFontFamily}" AutomationProperties.Name="Pairing code"/>
        </StackPanel>

        <TextBlock Classes="ErrorText" Text="{Binding ErrorMessage}"/>

        <StackPanel Orientation="Horizontal" Spacing="12">
            <Button Classes="Filled" Content="Pair" Command="{Binding PairCommand}" IsDefault="True"/>
            <ProgressBar Width="48" IsIndeterminate="True" VerticalAlignment="Center" IsVisible="{Binding IsBusy}"
                         ToolTip.Tip="Pairing…"/>
        </StackPanel>
    </StackPanel>

</UserControl>
