<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wl="using:Remote.Adb.Desktop.Devices.Wireless"
             x:Class="Remote.Adb.Desktop.Devices.Wireless.QrPairingView"
             x:DataType="wl:QrPairingViewModel">

    <StackPanel Spacing="8" Width="188">
        <!-- The code itself is always black on white (QrCodeControl), framed by a hairline so it reads as a card in
             either theme. Hidden when discovery can't see the device that scans it. -->
        <Border BorderBrush="{DynamicResource OutlineVariant}" BorderThickness="1" CornerRadius="8" Padding="0"
                ClipToBounds="True" HorizontalAlignment="Left" IsVisible="{Binding !Discovery.IsUnavailable}">
            <wl:QrCodeControl Text="{Binding QrText}" Width="186" Height="186"
                              AutomationProperties.Name="Pairing QR code"/>
        </Border>

        <TextBlock Classes="BodySmall" Foreground="{DynamicResource OnSurfaceVariant}" TextWrapping="Wrap"
                   IsVisible="{Binding !Discovery.IsUnavailable}"
                   Text="Scan with Wireless debugging › Pair device with QR code."/>

        <TextBlock Classes="BodySmall" Foreground="{DynamicResource OnSurfaceVariant}" TextWrapping="Wrap"
                   IsVisible="{Binding Discovery.IsUnavailable}"
                   Text="QR pairing needs discovery on this network (see below). Use the pairing code instead."/>

        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsBusy}">
            <ProgressBar Width="48" IsIndeterminate="True" VerticalAlignment="Center"/>
            <TextBlock Classes="BodySmall" Text="Pairing…" Foreground="{DynamicResource OnSurface}"/>
        </StackPanel>

        <TextBlock Classes="ErrorText" Text="{Binding ErrorMessage}"/>
    </StackPanel>

</UserControl>
