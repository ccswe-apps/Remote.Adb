<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:log="using:Remote.Adb.Desktop.Logging"
             x:Class="Remote.Adb.Desktop.Logging.LogEntryView"
             x:DataType="log:LogEntryViewModel"
             FontFamily="{DynamicResource CodeFontFamily}"
             FontSize="12">

    <UserControl.Styles>
        <!-- Commands the app ran stand out from ordinary app logging; warnings and errors take their status roles. -->
        <Style Selector="TextBlock.message.command">
            <Setter Property="Foreground" Value="{DynamicResource Primary}"/>
        </Style>
        <Style Selector="TextBlock.level.warning, TextBlock.message.warning">
            <Setter Property="Foreground" Value="{DynamicResource Warning}"/>
        </Style>
        <Style Selector="TextBlock.level.error, TextBlock.message.error">
            <Setter Property="Foreground" Value="{DynamicResource Error}"/>
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="12">
        <TextBlock Grid.Column="0" Text="{Binding Time}" Foreground="{DynamicResource OnSurfaceVariant}"/>
        <TextBlock Grid.Column="1" Classes="level" Text="{Binding LevelLabel}"
                   Classes.warning="{Binding IsWarning}" Classes.error="{Binding IsError}"
                   Foreground="{DynamicResource OnSurfaceVariant}"/>
        <TextBlock Grid.Column="2" Text="{Binding Category}" Foreground="{DynamicResource OnSurfaceVariant}"/>
        <SelectableTextBlock Grid.Column="3" Classes="message" Text="{Binding Message}" TextWrapping="Wrap"
                             Classes.command="{Binding IsCommand}"
                             Classes.warning="{Binding IsWarning}" Classes.error="{Binding IsError}"
                             Foreground="{DynamicResource OnSurface}"/>
    </Grid>

</UserControl>
