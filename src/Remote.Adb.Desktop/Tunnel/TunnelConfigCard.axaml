<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Remote.Adb.Desktop.Tunnel"
             xmlns:theme="using:CCSWE.Avalonia.Material"
             x:Class="Remote.Adb.Desktop.Tunnel.TunnelConfigCard"
             x:DataType="vm:TunnelViewModel">

    <!-- Edits the persisted tunnel settings inline and opens/closes the tunnel. DataContext is the page view
         model, inherited from the parent. -->
    <theme:Card Classes="Elevated">
        <StackPanel Spacing="16">
            <TextBlock Text="Connection" Classes="TitleMedium" Foreground="{DynamicResource OnSurface}"/>

            <StackPanel Classes="Field">
                <TextBlock Classes="FieldLabel" Text="Remote host"/>
                <TextBox Text="{Binding RemoteHost, UpdateSourceTrigger=LostFocus}" PlaceholderText="host or user@host"
                         AutomationProperties.Name="Remote host"/>
            </StackPanel>

            <Grid ColumnDefinitions="*,16,*">
                <StackPanel Grid.Column="0" Classes="Field">
                    <TextBlock Classes="FieldLabel" Text="Remote port"/>
                    <TextBox Text="{Binding RemotePort, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Remote port"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Classes="Field">
                    <TextBlock Classes="FieldLabel" Text="Local port"/>
                    <TextBox Text="{Binding LocalPort, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Local port"/>
                </StackPanel>
            </Grid>

            <ToggleSwitch Content="Connect automatically at launch" IsChecked="{Binding AutoConnect}"/>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="Filled" Content="Connect" Command="{Binding ConnectCommand}"
                        IsVisible="{Binding ShowConnect}"/>
                <Button Classes="Text" Content="Disconnect" Command="{Binding DisconnectCommand}"
                        IsVisible="{Binding CanDisconnect}"/>
            </StackPanel>
        </StackPanel>
    </theme:Card>

</UserControl>
