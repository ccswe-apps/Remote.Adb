<Project Sdk="Microsoft.NET.Sdk">

  <!-- Shared test helpers (fakes, mocks, builders) used by every *.UnitTests project. Not a test project itself. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Moq" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Remote.Adb.Core\Remote.Adb.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Fakes over Core's internal interfaces are internal themselves. -->
    <InternalsVisibleTo Include="Remote.Adb.Core.UnitTests" />
    <InternalsVisibleTo Include="Remote.Adb.Desktop.UnitTests" />
  </ItemGroup>

</Project>
